<style>
  .page {
    width: 100%;
  }

  section {
    width: 100%;
    padding: 0.5rem 2rem 4.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  section:last-child {
    border-bottom: none;
  }

  .section-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    padding-top: 3rem;
    margin-bottom: 1.25rem;
  }

  .section-heading {
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: var(--text-primary);
    margin-bottom: 2.5rem;
    max-width: 640px;
  }

  .compare-hero {
    padding-top: 4rem;
    padding-bottom: 4rem;
    background: var(--bg-subtle);
  }

  .hero-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
    max-width: 700px;
  }

  .hero-sub {
    font-size: 1rem;
    color: var(--text-secondary);
    max-width: 620px;
    line-height: 1.8;
  }

  .gap-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 720px;
  }

  .gap-body p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .gap-examples {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--border-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin: 0.5rem 0;
  }

  .gap-example {
    background: var(--bg-subtle);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .gap-example:hover {
    background: var(--bg-elevated);
  }

  .gap-example-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .gap-example-body {
    font-size: 0.825rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

