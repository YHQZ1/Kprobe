---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="kprobe"
  description="Deep kernel observability for financial systems. eBPF-powered causal graphs and deterministic replay."
>
  <div class="page">
    <section class="hero">
      <div class="hero-left">
        <div class="hero-eyebrow">
          <span class="eyebrow-dot"></span>
          eBPF · Causal Graphs · Deterministic Replay
        </div>
        <h1 class="hero-title">
          Kernel-level visibility<br />for financial systems.
        </h1>
        <p class="hero-sub">
          kprobe attaches to the Linux kernel using eBPF and captures everything
          your application-layer tools miss — CPU scheduling decisions, memory
          pressure events, network packet timing — without touching a single
          line of your code.
        </p>

        <div class="hero-points">
          <div class="hero-point">
            <div class="hpoint-dot"></div>
            <div class="hpoint-text">
              <span class="hpoint-title">No instrumentation required</span>
              <span class="hpoint-desc"
                >Attaches directly to kernel tracepoints. No library imports, no
                redeployment, no code changes ever.</span
              >
            </div>
          </div>
          <div class="hero-point">
            <div class="hpoint-dot"></div>
            <div class="hpoint-text">
              <span class="hpoint-title">Full causal chain to kernel level</span
              >
              <span class="hpoint-desc"
                >Not just what failed — exactly why, down to the kernel event
                that triggered it, across every service.</span
              >
            </div>
          </div>
          <div class="hero-point">
            <div class="hpoint-dot"></div>
            <div class="hpoint-text">
              <span class="hpoint-title">Deterministic incident replay</span>
              <span class="hpoint-desc"
                >Reproduce any production incident on a dev machine hours after
                it happened. Test fixes before shipping.</span
              >
            </div>
          </div>
        </div>

        <div class="hero-actions">
          <a href="/docs" class="btn-primary">Read the docs</a>
          <a href="/docs/how-it-works" class="btn-ghost">How it works →</a>
        </div>
        <div class="hero-meta">
          <span class="meta-item">Rust + Aya</span>
          <span class="meta-sep">·</span>
          <span class="meta-item">Go</span>
          <span class="meta-sep">·</span>
          <span class="meta-item">Kafka</span>
          <span class="meta-sep">·</span>
          <span class="meta-item">ClickHouse</span>
          <span class="meta-sep">·</span>
          <span class="meta-item">Neo4j</span>
          <span class="meta-sep">·</span>
          <span class="meta-item">Kubernetes</span>
        </div>
      </div>

      <div class="hero-right">
        <div class="hero-visual">
          <div class="visual-label">live · kernel event stream</div>
          <div class="visual-stream">
            <div class="stream-row">
              <span class="stream-ts">03:47:12.004</span>
              <span class="stream-type">tcp_sendmsg</span>
              <span class="stream-pid">PID 2841</span>
              <span class="stream-detail"
                >payment-handler → settlement-svc · 1.2kb</span
              >
            </div>
            <div class="stream-row">
              <span class="stream-ts">03:47:12.005</span>
              <span class="stream-type">sys_write</span>
              <span class="stream-pid">PID 2841</span>
              <span class="stream-detail">fd=7 · ledger write initiated</span>
            </div>
            <div class="stream-row">
              <span class="stream-ts">03:47:12.821</span>
              <span class="stream-type">mm_page_fault</span>
              <span class="stream-pid">PID 4721</span>
              <span class="stream-detail"
                >addr=0x7f3a · batch-job memory pressure</span
              >
            </div>
            <div class="stream-row stream-row-highlight">
              <span class="stream-ts">03:47:12.822</span>
              <span class="stream-type stream-type-accent">sched_switch</span>
              <span class="stream-pid">PID 2841</span>
              <span class="stream-detail stream-detail-accent"
                >preempted · CPU 3 → PID 4721</span
              >
            </div>
            <div class="stream-row">
              <span class="stream-ts">03:47:13.210</span>
              <span class="stream-type">sched_switch</span>
              <span class="stream-pid">PID 2841</span>
              <span class="stream-detail">resumed · CPU 3 · 388ms delayed</span>
            </div>
            <div class="stream-row">
              <span class="stream-ts">03:47:13.621</span>
              <span class="stream-type">sys_write</span>
              <span class="stream-pid">PID 2841</span>
              <span class="stream-detail">fd=7 · completed · 802ms total</span>
            </div>
            <div class="stream-row stream-row-muted">
              <span class="stream-ts">03:47:13.622</span>
              <span class="stream-type">tcp_recvmsg</span>
              <span class="stream-pid">PID 2841</span>
              <span class="stream-detail">timeout — payment-handler · ERR</span>
            </div>
          </div>
          <div class="visual-footer">
            <div class="vf-stat">
              <span class="vf-num">7</span>
              <span class="vf-label">events captured</span>
            </div>
            <div class="vf-divider"></div>
            <div class="vf-stat">
              <span class="vf-num">1</span>
              <span class="vf-label">root cause identified</span>
            </div>
            <div class="vf-divider"></div>
            <div class="vf-stat">
              <span class="vf-num">0</span>
              <span class="vf-label">lines of code changed</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="capabilities-section">
      <div class="section-label">capabilities</div>
      <div class="cap-grid">
        <div class="cap-main">
          <div class="cap-card cap-card-featured">
            <div class="cap-card-header">
              <div class="cap-icon">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <circle
                    cx="8"
                    cy="8"
                    r="2.5"
                    stroke="var(--accent)"
                    stroke-width="1.2"></circle>
                  <circle
                    cx="8"
                    cy="8"
                    r="5.5"
                    stroke="var(--accent)"
                    stroke-width="0.8"
                    stroke-dasharray="1.5 1.5"
                    opacity="0.5"></circle>
                  <circle
                    cx="8"
                    cy="8"
                    r="7.5"
                    stroke="var(--accent)"
                    stroke-width="0.5"
                    opacity="0.2"></circle>
                </svg>
              </div>
              <div class="cap-card-title">Zero-instrumentation capture</div>
            </div>
            <div class="cap-card-body">
              An eBPF probe attaches to kernel tracepoints as a Kubernetes
              DaemonSet. No library imports, no code changes, no redeployment.
              It sees everything from the moment it deploys.
            </div>
            <div class="cap-hooks">
              <code>tcp_sendmsg</code>
              <code>tcp_recvmsg</code>
              <code>sched_switch</code>
              <code>sys_write</code>
              <code>mm_page_fault</code>
            </div>
          </div>
          <div class="cap-card-row">
            <div class="cap-card">
              <div class="cap-card-header">
                <div class="cap-icon">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path
                      d="M2 8h3l2-5 3 10 2-5h2"
                      stroke="var(--accent)"
                      stroke-width="1.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </svg>
                </div>
                <div class="cap-card-title">Causal graph engine</div>
              </div>
              <div class="cap-card-body">
                Correlates kernel events with OTel traces on PID + timestamp.
                Builds a directed causal graph in Neo4j. Any financial event to
                root kernel cause in milliseconds.
              </div>
            </div>
            <div class="cap-card">
              <div class="cap-card-header">
                <div class="cap-icon">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path
                      d="M3 8V5l5-3 5 3v3"
                      stroke="var(--accent)"
                      stroke-width="1.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                    <path
                      d="M3 8l5 3 5-3M8 11v3"
                      stroke="var(--accent)"
                      stroke-width="1.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      opacity="0.5"></path>
                  </svg>
                </div>
                <div class="cap-card-title">Deterministic replay</div>
              </div>
              <div class="cap-card-body">
                Reproduce any production incident exactly on a dev machine via <code
                  >ptrace</code
                >. Inject timing changes, test fixes against the real event log
                before shipping.
              </div>
            </div>
          </div>
        </div>
        <div class="cap-side">
          <div class="cap-side-card">
            <div class="cap-icon">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path
                  d="M8 2v12M2 8h12"
                  stroke="var(--accent)"
                  stroke-width="1.2"
                  stroke-linecap="round"
                  opacity="0.4"></path>
                <circle cx="8" cy="8" r="2" fill="var(--accent)" opacity="0.8"
                ></circle>
                <path
                  d="M4 4l8 8M12 4l-8 8"
                  stroke="var(--accent)"
                  stroke-width="0.6"
                  stroke-linecap="round"
                  opacity="0.2"></path>
              </svg>
            </div>
            <div class="cap-card-title">Nanosecond precision</div>
            <div class="cap-card-body">
              Every event timestamped at nanosecond resolution. Timeline view
              zoomable to microsecond level across all services simultaneously.
            </div>
          </div>
          <div class="cap-side-card">
            <div class="cap-icon">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <rect
                  x="1.5"
                  y="4"
                  width="5"
                  height="3.5"
                  rx="0.8"
                  stroke="var(--accent)"
                  stroke-width="1.1"></rect>
                <rect
                  x="9.5"
                  y="8.5"
                  width="5"
                  height="3.5"
                  rx="0.8"
                  stroke="var(--accent)"
                  stroke-width="1.1"></rect>
                <path
                  d="M6.5 5.75h1.5a.5.5 0 01.5.5v3.25"
                  stroke="var(--accent)"
                  stroke-width="0.9"
                  stroke-linecap="round"
                  opacity="0.5"></path>
              </svg>
            </div>
            <div class="cap-card-title">Financial domain primitives</div>
            <div class="cap-card-body">
              Settlement boundaries, clearing windows, ledger writes, order book
              ops — kprobe maps kernel events to your financial domain natively.
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="trace-section">
      <div class="section-label">causal trace</div>
      <div class="trace-layout">
        <div class="trace-graph">
          <div class="trace-node">
            <div class="tnode-left">
              <div class="tnode-dot"></div>
              <div class="tnode-line"></div>
            </div>
            <div class="tnode-body">
              <div class="tnode-title">Payment #98721 received</div>
              <div class="tnode-meta">payment-handler · 03:47:12.004</div>
            </div>
            <div class="tnode-time">—</div>
          </div>
          <div class="trace-node">
            <div class="tnode-left">
              <div class="tnode-dot"></div>
              <div class="tnode-line"></div>
            </div>
            <div class="tnode-body">
              <div class="tnode-title">Risk check passed</div>
              <div class="tnode-meta">risk-engine · 03:47:12.408</div>
            </div>
            <div class="tnode-time">0.4ms</div>
          </div>
          <div class="trace-node">
            <div class="tnode-left">
              <div class="tnode-dot"></div>
              <div class="tnode-line"></div>
            </div>
            <div class="tnode-body">
              <div class="tnode-title">Settlement write initiated</div>
              <div class="tnode-meta">settlement-svc · 03:47:12.819</div>
            </div>
            <div class="tnode-time">1.2ms</div>
          </div>
          <div class="trace-node trace-kernel">
            <div class="tnode-left">
              <div class="tnode-dot tnode-dot-accent"></div>
              <div class="tnode-line tnode-line-accent"></div>
            </div>
            <div class="tnode-body">
              <div class="tnode-title tnode-title-accent">
                Memory pressure — kernel
              </div>
              <div class="tnode-meta">
                PID 4721 · batch-job competing for RAM · 03:47:12.821
              </div>
            </div>
            <span class="tnode-badge">root cause</span>
          </div>
          <div class="trace-node">
            <div class="tnode-left">
              <div class="tnode-dot tnode-dot-dim"></div>
              <div class="tnode-line tnode-line-dim"></div>
            </div>
            <div class="tnode-body">
              <div class="tnode-title">Settlement write completed</div>
              <div class="tnode-meta">settlement-svc · 03:47:13.621</div>
            </div>
            <div class="tnode-time tnode-time-slow">800ms</div>
          </div>
          <div class="trace-node">
            <div class="tnode-left">
              <div class="tnode-dot tnode-dot-dim"></div>
            </div>
            <div class="tnode-body">
              <div class="tnode-title tnode-title-dim">
                Payment failed — timeout exceeded 750ms
              </div>
              <div class="tnode-meta">payment-handler · 03:47:13.622</div>
            </div>
            <div class="tnode-time tnode-time-dim">+52ms</div>
          </div>
        </div>
        <div class="trace-aside">
          <div class="aside-stat">
            <div class="aside-num">5 min</div>
            <div class="aside-label">median investigation time with kprobe</div>
          </div>
          <div class="aside-stat">
            <div class="aside-num">4 hrs</div>
            <div class="aside-label">median investigation time without it</div>
          </div>
          <div class="aside-stat">
            <div class="aside-num">0</div>
            <div class="aside-label">lines of application code changed</div>
          </div>
          <p class="aside-note">
            kprobe was recording the entire time. The causal graph was ready
            before anyone woke up.
          </p>
        </div>
      </div>
    </section>

    <section class="gap-section">
      <div class="section-label">coverage</div>
      <h2 class="section-heading">What no other tool sees.</h2>
      <div class="table-wrap">
        <table class="compare-table">
          <thead>
            <tr>
              <th>Signal</th>
              <th>Datadog</th>
              <th>Jaeger</th>
              <th>OpenTelemetry</th>
              <th class="th-kp">kprobe</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Distributed traces</td>
              <td class="cell-yes">Yes</td>
              <td class="cell-yes">Yes</td>
              <td class="cell-partial">Instrumented only</td>
              <td class="cell-kp">Zero instrumentation</td>
            </tr>
            <tr>
              <td>Database query timing</td>
              <td class="cell-partial">Partial</td>
              <td class="cell-partial">Partial</td>
              <td class="cell-partial">Partial</td>
              <td class="cell-kp">Yes</td>
            </tr>
            <tr>
              <td>CPU scheduling decisions</td>
              <td class="cell-no">—</td>
              <td class="cell-no">—</td>
              <td class="cell-no">—</td>
              <td class="cell-kp">Yes</td>
            </tr>
            <tr>
              <td>Memory pressure events</td>
              <td class="cell-no">—</td>
              <td class="cell-no">—</td>
              <td class="cell-no">—</td>
              <td class="cell-kp">Yes</td>
            </tr>
            <tr>
              <td>Network packet-level timing</td>
              <td class="cell-no">—</td>
              <td class="cell-no">—</td>
              <td class="cell-no">—</td>
              <td class="cell-kp">Yes</td>
            </tr>
            <tr>
              <td>Cross-process causal chain</td>
              <td class="cell-no">—</td>
              <td class="cell-no">—</td>
              <td class="cell-no">—</td>
              <td class="cell-kp">Yes</td>
            </tr>
            <tr>
              <td>Root cause to kernel level</td>
              <td class="cell-no">—</td>
              <td class="cell-no">—</td>
              <td class="cell-no">—</td>
              <td class="cell-kp">Yes</td>
            </tr>
            <tr>
              <td>Deterministic incident replay</td>
              <td class="cell-no">—</td>
              <td class="cell-no">—</td>
              <td class="cell-no">—</td>
              <td class="cell-kp">Yes</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="install-section">
      <h2 class="install-heading">One command into any cluster.</h2>
      <p class="install-sub">
        Requires Kubernetes 1.26+ and Linux kernel 5.15+. No changes to existing
        services.
      </p>
      <div class="install-block">
        <div class="install-line">
          <span class="prompt">$</span>
          <code class="cmd">helm repo add kprobe https://charts.kprobe.io</code>
          <button
            class="copy-btn"
            data-copy="helm repo add kprobe https://charts.kprobe.io"
            aria-label="Copy"
          >
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
              <rect
                x="4.5"
                y="4.5"
                width="7"
                height="7"
                rx="1"
                stroke="currentColor"
                stroke-width="1.1"></rect>
              <path
                d="M2.5 8.5H2a1 1 0 01-1-1V2a1 1 0 011-1h5.5a1 1 0 011 1v.5"
                stroke="currentColor"
                stroke-width="1.1"
                stroke-linecap="round"></path>
            </svg>
          </button>
        </div>
        <div class="install-line">
          <span class="prompt">$</span>
          <code class="cmd"
            >helm install kprobe kprobe/kprobe --namespace monitoring
            --create-namespace</code
          >
          <button
            class="copy-btn"
            data-copy="helm install kprobe kprobe/kprobe --namespace monitoring --create-namespace"
            aria-label="Copy"
          >
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
              <rect
                x="4.5"
                y="4.5"
                width="7"
                height="7"
                rx="1"
                stroke="currentColor"
                stroke-width="1.1"></rect>
              <path
                d="M2.5 8.5H2a1 1 0 01-1-1V2a1 1 0 011-1h5.5a1 1 0 011 1v.5"
                stroke="currentColor"
                stroke-width="1.1"
                stroke-linecap="round"></path>
            </svg>
          </button>
        </div>
      </div>
      <div class="install-actions">
        <a href="/docs" class="btn-primary">Read the docs</a>
        <a
          href="https://github.com/YHQZ1/kprobe"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost">View on GitHub →</a
        >
      </div>
    </section>

    <section class="stack-section">
      <div class="section-label">built on</div>
      <h2 class="section-heading">Every technical decision was deliberate.</h2>
      <div class="stack-grid">
        <div class="stack-card">
          <img
            src="https://cdn.simpleicons.org/rust/f0eeeb"
            width="22"
            height="22"
            alt="Rust"
            class="stack-icon icon-dark"
          />
          <img
            src="https://cdn.simpleicons.org/rust/0e0e0f"
            width="22"
            height="22"
            alt=""
            class="stack-icon icon-light"
            aria-hidden="true"
          />
          <div class="stack-info">
            <div class="stack-name">Rust + Aya</div>
            <div class="stack-desc">
              Kernel-side eBPF programs and userspace loader. Compiled to eBPF
              bytecode. No C anywhere — memory-safe from the kernel up.
            </div>
          </div>
        </div>
        <div class="stack-card">
          <img
            src="https://cdn.simpleicons.org/go/00ADD8"
            width="22"
            height="22"
            alt="Go"
            class="stack-icon"
          />
          <div class="stack-info">
            <div class="stack-name">Go</div>
            <div class="stack-desc">
              Causal engine, replay engine, gRPC API server. Syscall
              interception for deterministic replay via ptrace.
            </div>
          </div>
        </div>
        <div class="stack-card">
          <img
            src="https://cdn.simpleicons.org/apachekafka/f0eeeb"
            width="22"
            height="22"
            alt="Kafka"
            class="stack-icon icon-dark"
          />
          <img
            src="https://cdn.simpleicons.org/apachekafka/0e0e0f"
            width="22"
            height="22"
            alt=""
            class="stack-icon icon-light"
            aria-hidden="true"
          />
          <div class="stack-info">
            <div class="stack-name">Apache Kafka</div>
            <div class="stack-desc">
              KRaft mode, topic-per-event-type. Handles millions of kernel
              events per second. Durable and replayable, no Zookeeper.
            </div>
          </div>
        </div>
        <div class="stack-card">
          <img
            src="https://cdn.simpleicons.org/clickhouse/FFCC01"
            width="22"
            height="22"
            alt="ClickHouse"
            class="stack-icon"
          />
          <div class="stack-info">
            <div class="stack-name">ClickHouse</div>
            <div class="stack-desc">
              Columnar storage for billions of timestamped kernel events.
              Sub-second analytical queries at scale.
            </div>
          </div>
        </div>
        <div class="stack-card">
          <img
            src="https://cdn.simpleicons.org/neo4j/008CC1"
            width="22"
            height="22"
            alt="Neo4j"
            class="stack-icon"
          />
          <div class="stack-info">
            <div class="stack-name">Neo4j</div>
            <div class="stack-desc">
              Graph database for causal relationships. Cypher queries traverse
              from any financial event to root kernel cause in milliseconds.
            </div>
          </div>
        </div>
        <div class="stack-card">
          <img
            src="https://cdn.simpleicons.org/kubernetes/326CE5"
            width="22"
            height="22"
            alt="Kubernetes"
            class="stack-icon"
          />
          <div class="stack-info">
            <div class="stack-name">Kubernetes</div>
            <div class="stack-desc">
              eBPF probe deployed as a DaemonSet across all nodes. Single Helm
              install deploys the full stack into any existing cluster.
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  document.querySelectorAll(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const text = (btn as HTMLElement).dataset.copy || "";
      navigator.clipboard.writeText(text).then(() => {
        const svg = btn.querySelector("svg");
        if (!svg) return;
        const prev = svg.innerHTML;
        svg.innerHTML = `<path d="M2 6.5l3 3 6-6" stroke="var(--accent)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>`;
        setTimeout(() => {
          svg.innerHTML = prev;
        }, 1800);
      });
    });
  });
</script>

<style>
  .page {
    width: 100%;
  }

  section {
    width: 100%;
    padding-top: 0.625rem;
    padding-bottom: 4rem;
    padding-left: 2rem;
    padding-right: 2rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  section:last-child {
    border-bottom: none;
  }

  .section-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.5rem;
    padding-top: 2.5rem;
  }

  .section-heading {
    font-size: clamp(1.4rem, 2.5vw, 1.9rem);
