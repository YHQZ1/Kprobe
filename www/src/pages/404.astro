---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404" description="Page not found.">
  <div class="not-found">
    <div class="code">404</div>
    <div class="divider"></div>
    <div class="right">
      <h1 class="title">Page not found</h1>
      <p class="sub">
        The page you are looking for does not exist or has been moved.
      </p>
      <div class="links">
        <a href="/" class="link-primary">Back to home</a>
        <a href="/docs" class="link-ghost">Read the docs →</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .not-found {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    min-height: calc(100vh - 56px);
    padding: 2rem;
  }

  .code {
    font-size: 6rem;
    font-weight: 700;
    letter-spacing: -0.05em;
    color: var(--border);
    line-height: 1;
    flex-shrink: 0;
  }

  .divider {
    width: 1px;
    height: 80px;
    background: var(--border);
    flex-shrink: 0;
  }

  .right {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .title {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .sub {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 300px;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }

  .link-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.25rem;
    background: var(--accent);
    color: #0e0e0f;
    border-radius: var(--radius-sm);
    font-size: 0.825rem;
    font-weight: 700;
    font-family: var(--font);
    text-decoration: none;
  }

  .link-primary:hover {
    opacity: 0.88;
  }

  .link-ghost {
    font-size: 0.825rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
  }

  .link-ghost:hover {
    color: var(--text-primary);
  }
</style>
