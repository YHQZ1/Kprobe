---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Kernel-level flight recorder for production systems.",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link
      rel="preload"
      href="/fonts/Raleway/Raleway-VariableFont_wght.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <title>Kprobe: {title}</title>
    <style is:inline>
      @font-face {
        font-family: "Raleway";
        src: url("/fonts/Raleway/Raleway-VariableFont_wght.ttf")
          format("truetype");
        font-weight: 100 900;
        font-style: normal;
        font-display: block;
      }

      :root,
      [data-theme="dark"] {
        --bg: #0e0e0f;
        --bg-subtle: #141415;
        --bg-elevated: #1a1a1b;
        --border: #242426;
        --border-subtle: #1e1e20;
        --text-primary: #f0eeeb;
        --text-secondary: #a09e9b;
        --text-muted: #5c5a57;
        --accent: #f59e0b;
        --accent-dim: rgba(245, 158, 11, 0.12);
        --accent-dim-hover: rgba(245, 158, 11, 0.2);
        --overlay: rgba(0, 0, 0, 0.66);
        --shadow-lg: 0 24px 64px rgba(0, 0, 0, 0.46);
        --button-text-on-accent: #0e0e0f;
        --font: "Raleway", system-ui, -apple-system, sans-serif;
        --radius-sm: 4px;
        --radius-md: 8px;
        --radius-lg: 8px;
      }

      [data-theme="light"] {
        --bg: #f5f3f0;
        --bg-subtle: #edeae6;
        --bg-elevated: #e5e2de;
        --border: #d0cdc8;
        --border-subtle: #d8d5d0;
        --text-primary: #0e0e0f;
        --text-secondary: #4a4845;
        --text-muted: #8a8784;
        --accent: #d97706;
        --accent-dim: rgba(217, 119, 6, 0.1);
        --accent-dim-hover: rgba(217, 119, 6, 0.18);
        --overlay: rgba(14, 14, 15, 0.28);
        --shadow-lg: 0 24px 64px rgba(14, 14, 15, 0.16);
        --button-text-on-accent: #ffffff;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        min-height: 100%;
        background: var(--bg);
        color: var(--text-primary);
        color-scheme: dark;
        font-family: var(--font);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      html[data-theme="light"] {
        color-scheme: light;
      }

      body {
        min-height: 100vh;
        background: var(--bg);
        color: var(--text-primary);
        font-family: var(--font);
        line-height: 1.6;
      }

      #navbar {
        position: fixed;
        inset: 0 0 auto;
        z-index: 100;
        height: 56px;
        background: var(--bg);
        border-bottom: 1px solid var(--border-subtle);
      }

      main {
        padding-top: 56px;
      }
    </style>
    <script is:inline>
      (() => {
        let saved;
        try {
          saved = localStorage.getItem("kprobe-theme");
        } catch {
          saved = null;
        }
        const theme = saved === "light" || saved === "dark" ? saved : "dark";
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: var(--bg);
    color: var(--text-primary);
    font-family: var(--font);
  }

  main {
    flex: 1;
    padding-top: 56px;
  }
</style>
