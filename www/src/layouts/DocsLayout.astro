---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import DocsSidebar from "../components/DocsSidebar.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "kprobe documentation" } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — kprobe docs</title>
    <script is:inline>
      (function () {
        const saved = localStorage.getItem("kprobe-theme") || "dark";
        document.documentElement.setAttribute("data-theme", saved);
      })();
    </script>
    <style is:inline>
      :root,
      [data-theme="dark"] {
        --bg: #0e0e0f;
        --bg-subtle: #141415;
        --bg-elevated: #1a1a1b;
        --border: #242426;
        --border-subtle: #1e1e20;
        --text-primary: #f0eeeb;
        --text-secondary: #a09e9b;
        --text-muted: #5c5a57;
        --accent: #f59e0b;
        --accent-dim: rgba(245, 158, 11, 0.12);
        --accent-dim-hover: rgba(245, 158, 11, 0.2);
      }
      [data-theme="light"] {
        --bg: #f5f3f0;
        --bg-subtle: #edeae6;
        --bg-elevated: #e5e2de;
        --border: #d0cdc8;
        --border-subtle: #d8d5d0;
        --text-primary: #0e0e0f;
        --text-secondary: #4a4845;
        --text-muted: #8a8784;
        --accent: #d97706;
        --accent-dim: rgba(217, 119, 6, 0.1);
        --accent-dim-hover: rgba(217, 119, 6, 0.18);
      }
      html {
        background-color: var(--bg);
        color: var(--text-primary);
      }
      body {
        background-color: var(--bg);
        visibility: hidden;
      }
    </style>
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        document.body.style.visibility = "visible";
      });
    </script>
  </head>
  <body>
    <Navbar />
    <div class="docs-shell">
      <DocsSidebar />
      <main class="docs-main">
        <div class="docs-content">
          <slot />
        </div>
      </main>
    </div>
    <div class="sidebar-overlay" id="sidebar-overlay"></div>
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    background-color: var(--bg);
    color: var(--text-primary);
    font-family: var(--font);
  }

  .docs-shell {
    display: flex;
    padding-top: 56px;
    min-height: 100vh;
  }

  .docs-main {
    flex: 1;
    min-width: 0;
    width: 100%;
    border-left: 1px solid var(--border-subtle);
  }

  .docs-content {
    width: 100%;
    max-width: 80%;
    padding: 3.5rem 4rem 6rem 3.5rem;
  }

  .sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    z-index: 49;
    backdrop-filter: blur(2px);
  }

  .sidebar-overlay.active {
    display: block;
  }

  .docs-content :global(h1) {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--text-primary);
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .docs-content :global(h2) {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--text-primary);
    margin-top: 3rem;
    margin-bottom: 0.875rem;
  }

  .docs-content :global(h3) {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.4;
    color: var(--text-primary);
    margin-top: 2rem;
    margin-bottom: 0.625rem;
  }

  .docs-content :global(h4) {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .docs-content :global(p) {
    font-size: 0.925rem;
    color: var(--text-secondary);
    line-height: 1.85;
    margin-bottom: 1.1rem;
  }

  .docs-content :global(p + h2),
  .docs-content :global(ul + h2),
  .docs-content :global(ol + h2),
  .docs-content :global(pre + h2),
  .docs-content :global(table + h2) {
    margin-top: 3.5rem;
  }

  .docs-content :global(a) {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--accent-dim);
  }

  .docs-content :global(a:hover) {
    border-bottom-color: var(--accent);
  }

  .docs-content :global(strong) {
    font-weight: 600;
    color: var(--text-primary);
  }

  .docs-content :global(em) {
    color: var(--text-secondary);
    font-style: italic;
  }

  .docs-content :global(ul),
  .docs-content :global(ol) {
    margin-bottom: 1.1rem;
    padding-left: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    list-style: none;
  }

  .docs-content :global(ul li),
  .docs-content :global(ol li) {
    font-size: 0.925rem;
    color: var(--text-secondary);
    line-height: 1.75;
    padding-left: 1.25rem;
    position: relative;
  }

  .docs-content :global(ul li::before) {
    content: "·";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
    font-size: 1.1rem;
    top: -2px;
  }

  .docs-content :global(ol) {
    counter-reset: list-counter;
  }

  .docs-content :global(ol li) {
    counter-increment: list-counter;
  }

  .docs-content :global(ol li::before) {
    content: counter(list-counter) ".";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.8rem;
    top: 2px;
  }

  .docs-content :global(code) {
    font-family: "JetBrains Mono", "Fira Code", "Cascadia Code", monospace;
    font-size: 0.82em;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.15em 0.45em;
    color: var(--accent);
  }

  .docs-content :global(pre) {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    position: relative;
  }

  .docs-content :global(pre code) {
    background: transparent;
    border: none;
    padding: 0;
    color: var(--text-secondary);
    font-size: 0.835rem;
    line-height: 1.75;
  }

  .docs-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.875rem;
  }

  .docs-content :global(thead tr) {
    border-bottom: 1px solid var(--border);
  }

  .docs-content :global(th) {
    text-align: left;
    padding: 0.625rem 1rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .docs-content :global(td) {
    padding: 0.625rem 1rem;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.6;
    vertical-align: top;
  }

  .docs-content :global(tr:last-child td) {
    border-bottom: none;
  }

  .docs-content :global(tr:hover td) {
    background: var(--bg-subtle);
  }

  .docs-content :global(td code),
  .docs-content :global(th code) {
    font-size: 0.8rem;
  }

  .docs-content :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding: 0.75rem 1.25rem;
    margin: 1.5rem 0;
    background: var(--accent-dim);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .docs-content :global(blockquote p) {
    color: var(--text-secondary);
    margin-bottom: 0;
    font-style: italic;
  }

  .docs-content :global(hr) {
    border: none;
    border-top: 1px solid var(--border-subtle);
    margin: 2.5rem 0;
  }

  @media (max-width: 768px) {
    .docs-main {
      border-left: none;
    }

    .docs-content {
      padding: 2rem 1.25rem 4rem;
    }
  }
</style>

<script>
  const overlay = document.getElementById("sidebar-overlay");
  const sidebar = document.getElementById("docs-sidebar");

  overlay?.addEventListener("click", () => {
    sidebar?.classList.remove("sidebar-open");
    overlay?.classList.remove("active");
  });

  window.addEventListener("open-sidebar", () => {
    sidebar?.classList.add("sidebar-open");
    overlay?.classList.add("active");
  });
</script>
