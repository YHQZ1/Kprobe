---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import DocsSidebar from "../components/DocsSidebar.astro";

interface Props {
  title?: string;
  description?: string;
  frontmatter?: {
    title?: string;
    description?: string;
  };
}

const frontmatter = Astro.props.frontmatter ?? Astro.props;
const title = frontmatter.title ?? "Docs";
const description = frontmatter.description ?? "kprobe documentation";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link
      rel="preload"
      href="/fonts/Raleway/Raleway-VariableFont_wght.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <title>Kprobe Documentation: {title}</title>
    <style is:inline>
      @font-face {
        font-family: "Raleway";
        src: url("/fonts/Raleway/Raleway-VariableFont_wght.ttf")
          format("truetype");
        font-weight: 100 900;
        font-style: normal;
        font-display: block;
      }

      :root,
      [data-theme="dark"] {
        --bg: #0e0e0f;
        --bg-subtle: #141415;
        --bg-elevated: #1a1a1b;
        --border: #242426;
        --border-subtle: #1e1e20;
        --text-primary: #f0eeeb;
        --text-secondary: #a09e9b;
        --text-muted: #5c5a57;
        --accent: #f59e0b;
        --accent-dim: rgba(245, 158, 11, 0.12);
        --accent-dim-hover: rgba(245, 158, 11, 0.2);
        --overlay: rgba(0, 0, 0, 0.66);
        --shadow-lg: 0 24px 64px rgba(0, 0, 0, 0.46);
        --button-text-on-accent: #0e0e0f;
        --font: "Raleway", system-ui, -apple-system, sans-serif;
        --radius-sm: 4px;
        --radius-md: 8px;
        --radius-lg: 8px;
      }

      [data-theme="light"] {
        --bg: #f5f3f0;
        --bg-subtle: #edeae6;
        --bg-elevated: #e5e2de;
        --border: #d0cdc8;
        --border-subtle: #d8d5d0;
        --text-primary: #0e0e0f;
        --text-secondary: #4a4845;
        --text-muted: #8a8784;
        --accent: #d97706;
        --accent-dim: rgba(217, 119, 6, 0.1);
        --accent-dim-hover: rgba(217, 119, 6, 0.18);
        --overlay: rgba(14, 14, 15, 0.28);
        --shadow-lg: 0 24px 64px rgba(14, 14, 15, 0.16);
        --button-text-on-accent: #ffffff;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        min-height: 100%;
        background: var(--bg);
        color: var(--text-primary);
        color-scheme: dark;
        font-family: var(--font);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      html[data-theme="light"] {
        color-scheme: light;
      }

      body {
        min-height: 100vh;
        background: var(--bg);
        color: var(--text-primary);
        font-family: var(--font);
        line-height: 1.6;
      }

      #navbar {
        position: fixed;
        inset: 0 0 auto;
        z-index: 100;
        height: 56px;
        background: var(--bg);
        border-bottom: 1px solid var(--border-subtle);
      }

      .docs-shell {
        display: flex;
        min-height: 100vh;
        padding-top: 56px;
      }

      .docs-main {
        flex: 1;
        min-width: 0;
        width: 100%;
        border-left: 1px solid var(--border-subtle);
      }
    </style>
    <script is:inline>
      (() => {
        let saved;
        try {
          saved = localStorage.getItem("kprobe-theme");
        } catch {
          saved = null;
        }
        const theme = saved === "light" || saved === "dark" ? saved : "dark";
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body>
    <Navbar />
    <div class="docs-shell">
      <DocsSidebar />
      <main class="docs-main">
        <div class="docs-content">
          <slot />
        </div>
      </main>
    </div>
    <div class="sidebar-overlay" id="sidebar-overlay"></div>
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    background-color: var(--bg);
    color: var(--text-primary);
    font-family: var(--font);
  }

  .docs-shell {
    display: flex;
    padding-top: 56px;
    min-height: 100vh;
  }

  .docs-main {
    flex: 1;
    min-width: 0;
    width: 100%;
    border-left: 1px solid var(--border-subtle);
  }

  .docs-content {
    width: 100%;
    max-width: 1040px;
    padding: 3.5rem clamp(1.25rem, 5vw, 4rem) 6rem;
  }

  .sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: var(--overlay);
    z-index: 49;
    backdrop-filter: blur(2px);
  }

  .sidebar-overlay.active {
    display: block;
  }

  .docs-content :global(h1) {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--text-primary);
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .docs-content :global(h2) {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--text-primary);
    margin-top: 3rem;
    margin-bottom: 0.875rem;
  }

  .docs-content :global(h3) {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.4;
    color: var(--text-primary);
    margin-top: 2rem;
    margin-bottom: 0.625rem;
  }

  .docs-content :global(h4) {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .docs-content :global(p) {
    font-size: 0.925rem;
    color: var(--text-secondary);
    line-height: 1.85;
    margin-bottom: 1.1rem;
  }

  .docs-content :global(p + h2),
  .docs-content :global(ul + h2),
  .docs-content :global(ol + h2),
  .docs-content :global(pre + h2),
  .docs-content :global(table + h2) {
    margin-top: 3.5rem;
  }

  .docs-content :global(a) {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--accent-dim);
  }

  .docs-content :global(a:hover) {
    border-bottom-color: var(--accent);
  }

  .docs-content :global(strong) {
    font-weight: 600;
    color: var(--text-primary);
  }

  .docs-content :global(em) {
    color: var(--text-secondary);
    font-style: italic;
  }

  .docs-content :global(ul),
  .docs-content :global(ol) {
    margin-bottom: 1.1rem;
    padding-left: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    list-style: none;
  }

  .docs-content :global(ul li),
  .docs-content :global(ol li) {
    font-size: 0.925rem;
    color: var(--text-secondary);
    line-height: 1.75;
    padding-left: 1.25rem;
    position: relative;
  }

  .docs-content :global(ul li::before) {
    content: "·";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
    font-size: 1.1rem;
    top: -2px;
  }

  .docs-content :global(ol) {
    counter-reset: list-counter;
  }

  .docs-content :global(ol li) {
    counter-increment: list-counter;
  }

  .docs-content :global(ol li::before) {
    content: counter(list-counter) ".";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.8rem;
    top: 2px;
  }

  .docs-content :global(code) {
    font-family: "JetBrains Mono", "Fira Code", "Cascadia Code", monospace;
    font-size: 0.82em;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.15em 0.45em;
    color: var(--accent);
  }

  .docs-content :global(.code-block) {
    position: relative;
    margin: 1.5rem 0;
  }

  .docs-content :global(pre) {
    background: var(--code-bg, var(--bg-subtle));
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem 3.5rem 1.25rem 1.5rem;
    overflow-x: auto;
    margin: 0;
    position: relative;
  }

  @media (prefers-reduced-motion: no-preference) {
    .docs-content :global(.code-block) {
      animation: content-rise 260ms var(--ease-out) both;
    }

    .docs-content :global(pre),
    .docs-content :global(blockquote),
    .docs-content :global(table) {
      transition:
        border-color var(--motion-fast) var(--ease-standard),
        box-shadow var(--motion-fast) var(--ease-standard),
        transform var(--motion-fast) var(--ease-standard);
    }

    .docs-content :global(.code-block:hover pre) {
      box-shadow: var(--shadow-lg);
      transform: translateY(-1px);
    }

    @keyframes content-rise {
      from {
        opacity: 0;
        transform: translateY(3px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }

  .docs-content :global(pre code) {
    background: transparent;
    border: none;
    padding: 0;
    color: var(--code-text, var(--text-secondary));
    font-size: 0.835rem;
    line-height: 1.75;
  }

  .docs-content :global(.copy-code-btn) {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--copy-btn-bg, var(--bg-elevated));
    color: var(--copy-btn-text, var(--text-muted));
    cursor: pointer;
  }

  .docs-content :global(.copy-code-btn:hover) {
    color: var(--text-primary);
    border-color: var(--text-muted);
  }

  .docs-content :global(.copy-code-btn.copied) {
    color: var(--accent);
    border-color: var(--accent);
  }

  :global([data-theme="light"]) {
    --code-bg: #ebe7e1;
    --code-text: #171717;
    --copy-btn-bg: #f7f4ef;
    --copy-btn-text: #4a4845;
  }

  :global([data-theme="light"]) .docs-content :global(pre) {
    background: var(--code-bg) !important;
    background-color: var(--code-bg) !important;
    border-color: #d8d2c9;
  }

  :global([data-theme="light"]) .docs-content :global(pre code) {
    color: var(--code-text) !important;
    text-shadow: none;
  }

  :global([data-theme="light"]) .docs-content :global(pre code span) {
    color: var(--code-text) !important;
  }

  .docs-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.875rem;
  }

  .docs-content :global(thead tr) {
    border-bottom: 1px solid var(--border);
  }

  .docs-content :global(th) {
    text-align: left;
    padding: 0.625rem 1rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .docs-content :global(td) {
    padding: 0.625rem 1rem;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.6;
    vertical-align: top;
  }

  .docs-content :global(tr:last-child td) {
    border-bottom: none;
  }

  .docs-content :global(tr:hover td) {
    background: var(--bg-subtle);
  }

  .docs-content :global(td code),
  .docs-content :global(th code) {
    font-size: 0.8rem;
  }

  .docs-content :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding: 0.75rem 1.25rem;
    margin: 1.5rem 0;
    background: var(--accent-dim);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .docs-content :global(blockquote p) {
    color: var(--text-secondary);
    margin-bottom: 0;
    font-style: italic;
  }

  .docs-content :global(hr) {
    border: none;
    border-top: 1px solid var(--border-subtle);
    margin: 2.5rem 0;
  }

  @media (max-width: 768px) {
    .docs-main {
      border-left: none;
    }

    .docs-content {
      padding: 2rem 1.25rem 4rem;
    }
  }

  @media (max-width: 560px) {
    .docs-content :global(h1) {
      font-size: 1.65rem;
    }

    .docs-content :global(table) {
      display: block;
      overflow-x: auto;
      white-space: nowrap;
    }

    .docs-content :global(pre) {
      padding: 1rem 3.25rem 1rem 1rem;
    }
  }
</style>

<script>
  const overlay = document.getElementById("sidebar-overlay");
  const sidebar = document.getElementById("docs-sidebar");

  overlay?.addEventListener("click", () => {
    sidebar?.classList.remove("sidebar-open");
    overlay?.classList.remove("active");
  });

  window.addEventListener("open-sidebar", () => {
    sidebar?.classList.add("sidebar-open");
    overlay?.classList.add("active");
  });

  const copyIcon = `
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="9" y="9" width="11" height="11" rx="2" stroke="currentColor" stroke-width="2"></rect>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
    </svg>
  `;

  const checkIcon = `
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  `;

  function enhanceCodeBlocks() {
    document.querySelectorAll(".docs-content pre").forEach((pre) => {
      if (pre.parentElement?.classList.contains("code-block")) return;

      const wrapper = document.createElement("div");
      wrapper.className = "code-block";
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);

      const button = document.createElement("button");
      button.type = "button";
      button.className = "copy-code-btn";
      button.setAttribute("aria-label", "Copy code");
      button.innerHTML = copyIcon;

      button.addEventListener("click", async () => {
        const code = pre.textContent ?? "";

        if (await copyText(code.trimEnd())) {
          button.classList.add("copied");
          button.setAttribute("aria-label", "Copied");
          button.innerHTML = checkIcon;

          window.setTimeout(() => {
            button.classList.remove("copied");
            button.setAttribute("aria-label", "Copy code");
            button.innerHTML = copyIcon;
          }, 1400);
        } else {
          selectCode(pre);
          button.setAttribute("aria-label", "Code selected");
          button.innerHTML = checkIcon;

          window.setTimeout(() => {
            button.setAttribute("aria-label", "Copy code");
            button.innerHTML = copyIcon;
          }, 1400);
        }
      });

      wrapper.appendChild(button);
    });
  }

  async function copyText(text) {
    if (navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        // Fall through to the legacy path for browsers that block clipboard.
      }
    }

    const textarea = document.createElement("textarea");
    textarea.value = text;
    textarea.setAttribute("readonly", "");
    textarea.style.position = "fixed";
    textarea.style.top = "-9999px";
    textarea.style.left = "-9999px";
    document.body.appendChild(textarea);
    textarea.select();

    try {
      return document.execCommand("copy");
    } finally {
      textarea.remove();
    }
  }

  function selectCode(pre) {
    const range = document.createRange();
    range.selectNodeContents(pre);

    const selection = window.getSelection();
    selection?.removeAllRanges();
    selection?.addRange(range);
  }

  enhanceCodeBlocks();
  document.addEventListener("astro:page-load", enhanceCodeBlocks);
</script>
