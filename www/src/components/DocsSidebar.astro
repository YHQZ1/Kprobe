---
const currentPath = Astro.url.pathname;

const nav = [
  {
    group: "Start Here",
    items: [
      { label: "Overview", href: "/docs" },
      { label: "Quickstart", href: "/docs/quickstart" },
      { label: "What kprobe Solves", href: "/docs/what-kprobe-solves" },
      { label: "Architecture at a Glance", href: "/docs/architecture" },
    ],
  },
  {
    group: "Install",
    items: [
      { label: "Installation Overview", href: "/docs/installation" },
      { label: "Amazon EKS", href: "/docs/install/eks" },
      { label: "Amazon ECS on EC2", href: "/docs/install/ecs-ec2" },
      { label: "Bare Linux", href: "/docs/install/linux" },
      { label: "Local Demo", href: "/docs/install/local-demo" },
    ],
  },
  {
    group: "Core Concepts",
    items: [
      { label: "Kernel Events", href: "/docs/concepts/kernel-events" },
      { label: "Trace Correlation", href: "/docs/concepts/trace-correlation" },
      { label: "Causal Graphs", href: "/docs/concepts/causal-graphs" },
      { label: "Replay Sessions", href: "/docs/concepts/replay-sessions" },
      { label: "Service Identity", href: "/docs/concepts/service-identity" },
    ],
  },
  {
    group: "How It Works",
    items: [
      { label: "System Flow", href: "/docs/how-it-works" },
      { label: "Recorder", href: "/docs/how-it-works/recorder" },
      { label: "Event Pipeline", href: "/docs/how-it-works/event-pipeline" },
      { label: "Enrichment", href: "/docs/how-it-works/enrichment" },
      { label: "Causal Inference", href: "/docs/how-it-works/causal-inference" },
      { label: "Storage", href: "/docs/how-it-works/storage" },
    ],
  },
  {
    group: "Use Cases",
    items: [
      { label: "Payment Timeout", href: "/docs/use-cases/payment-timeout" },
      { label: "Database Write Latency", href: "/docs/use-cases/database-write-latency" },
      { label: "TCP Retransmits", href: "/docs/use-cases/tcp-retransmits" },
      { label: "Scheduler Delay", href: "/docs/use-cases/scheduler-delay" },
      { label: "Noisy Neighbor", href: "/docs/use-cases/noisy-neighbor" },
    ],
  },
  {
    group: "Using the Dashboard",
    items: [
      { label: "Causal Graph View", href: "/docs/dashboard/causal-graph" },
      { label: "Timeline View", href: "/docs/dashboard/timeline" },
      { label: "Replay Panel", href: "/docs/dashboard/replay" },
    ],
  },
  {
    group: "Configuration",
    items: [
      { label: "Configuration Overview", href: "/docs/configuration" },
      { label: "Helm Values", href: "/docs/configuration/helm-values" },
      { label: "Agent", href: "/docs/configuration/agent" },
      { label: "OpenTelemetry", href: "/docs/configuration/opentelemetry" },
      { label: "Storage", href: "/docs/configuration/storage" },
    ],
  },
  {
    group: "Operations",
    items: [
      { label: "Production Deployment", href: "/docs/operations/production" },
      { label: "Monitor kprobe", href: "/docs/operations/monitor-kprobe" },
      { label: "Dropped Events", href: "/docs/operations/dropped-events" },
      { label: "Storage Sizing", href: "/docs/operations/storage-sizing" },
    ],
  },
  {
    group: "Security",
    items: [
      { label: "Security Overview", href: "/docs/security" },
      { label: "Permissions Model", href: "/docs/security/permissions" },
      { label: "Data Collected", href: "/docs/security/data-collected" },
      { label: "Authentication", href: "/docs/security/authentication" },
    ],
  },
  {
    group: "API Reference",
    items: [
      { label: "Overview", href: "/docs/api/overview" },
      { label: "Events API", href: "/docs/api/events" },
      { label: "Causal Graph API", href: "/docs/api/causal-graph" },
      { label: "Replay API", href: "/docs/api/replay" },
      { label: "Streaming API", href: "/docs/api/streaming" },
      { label: "gRPC Reference", href: "/docs/api/reference" },
    ],
  },
  {
    group: "Troubleshooting",
    items: [
      { label: "Overview", href: "/docs/troubleshooting" },
      { label: "Agent Issues", href: "/docs/troubleshooting/agent" },
      { label: "No Events", href: "/docs/troubleshooting/no-events" },
      { label: "No Correlation", href: "/docs/troubleshooting/no-correlation" },
      { label: "Dashboard Issues", href: "/docs/troubleshooting/dashboard" },
    ],
  },
  {
    group: "Reference",
    items: [
      { label: "Event Schema", href: "/docs/reference/event-schema" },
      { label: "Edge Types", href: "/docs/reference/edge-types" },
      { label: "Supported Platforms", href: "/docs/reference/supported-platforms" },
      { label: "Glossary", href: "/docs/reference/glossary" },
      { label: "FAQ", href: "/docs/faq" },
    ],
  },
];

function isActive(href: string) {
  if (href === "/docs")
    return currentPath === "/docs" || currentPath === "/docs/";
  return currentPath.startsWith(href);
}
---

<aside id="docs-sidebar">
  <div class="sidebar-header">
    <span class="sidebar-title">Documentation</span>
    <button class="sidebar-close" id="sidebar-close" aria-label="Close sidebar">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path
          d="M1 1l12 12M13 1L1 13"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div class="sidebar-mobile-toggle" id="sidebar-toggle">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
      <path
        d="M2 4h12M2 8h12M2 12h12"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"></path>
    </svg>
    <span>Menu</span>
  </div>

  <nav class="sidebar-nav">
    {
      nav.map((section) => (
        <div class="nav-group">
          <div class="nav-group-label">{section.group}</div>
          {section.items.map((item) => (
            <a
              href={item.href}
              class={`nav-item ${isActive(item.href) ? "nav-item-active" : ""}`}
            >
              {item.label}
            </a>
          ))}
        </div>
      ))
    }
  </nav>
</aside>

<style>
  aside {
    width: 260px;
    flex-shrink: 0;
    position: sticky;
    top: 56px;
    height: calc(100vh - 56px);
    overflow-y: auto;
    padding: 1.5rem 0;
    background: var(--bg);
  }

  .sidebar-header {
    display: none;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 0.5rem;
  }

  .sidebar-title {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .sidebar-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: none;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    border-radius: var(--radius-sm);
  }

  .sidebar-close:hover {
    background: var(--bg-elevated);
    color: var(--text-primary);
  }

  .sidebar-mobile-toggle {
    display: none;
  }

  .sidebar-nav {
    padding: 0 0.75rem;
  }

  .nav-group {
    margin-bottom: 1.75rem;
  }

  .nav-group-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding: 0 0.625rem;
    margin-bottom: 0.375rem;
  }

  .nav-item {
    display: block;
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--text-secondary);
    padding: 0.375rem 0.625rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    letter-spacing: 0.01em;
    line-height: 1.4;
  }

  .nav-item + .nav-item {
    margin-top: 2px;
  }

  .nav-item:hover {
    color: var(--text-primary);
    background: var(--bg-elevated);
  }

  .nav-item-active {
    color: var(--accent);
    background: var(--accent-dim);
    font-weight: 500;
  }

  .nav-item-active:hover {
    background: var(--accent-dim-hover);
    color: var(--accent);
  }

  aside::-webkit-scrollbar {
    width: 4px;
  }
  aside::-webkit-scrollbar-track {
    background: transparent;
  }
  aside::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 2px;
  }

  @media (max-width: 768px) {
    aside {
      position: fixed;
      top: 56px;
      left: 0;
      bottom: 0;
      z-index: 50;
      width: 280px;
      transform: translateX(-100%);
      transition: transform 200ms ease;
      border-right: 1px solid var(--border);
      height: calc(100vh - 56px);
    }

    aside.sidebar-open {
      transform: translateX(0);
    }

    .sidebar-header {
      display: flex;
    }

    .sidebar-mobile-toggle {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      position: fixed;
      bottom: 1.5rem;
      left: 1.25rem;
      z-index: 48;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 0.5rem 0.875rem;
      font-size: 0.8rem;
      font-weight: 500;
      color: var(--text-secondary);
      cursor: pointer;
      font-family: var(--font);
    }
  }
</style>

<script>
  const toggle = document.getElementById("sidebar-toggle");
  const close = document.getElementById("sidebar-close");

  toggle?.addEventListener("click", () => {
    window.dispatchEvent(new Event("open-sidebar"));
  });

  close?.addEventListener("click", () => {
    document.getElementById("docs-sidebar")?.classList.remove("sidebar-open");
    document.getElementById("sidebar-overlay")?.classList.remove("active");
  });
</script>
