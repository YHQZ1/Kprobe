---
const currentPath = Astro.url.pathname;

const nav = [
  {
    group: "Getting Started",
    items: [
      { label: "Introduction", href: "/docs" },
      { label: "Installation", href: "/docs/installation" },
      { label: "Quickstart", href: "/docs/quickstart" },
    ],
  },
  {
    group: "How It Works",
    items: [
      { label: "Overview", href: "/docs/how-it-works" },
      { label: "Architecture", href: "/docs/architecture" },
    ],
  },
  {
    group: "Using the Dashboard",
    items: [
      { label: "Causal Graph View", href: "/docs/dashboard/causal-graph" },
      { label: "Timeline View", href: "/docs/dashboard/timeline" },
      { label: "Replay Panel", href: "/docs/dashboard/replay" },
    ],
  },
  {
    group: "API",
    items: [
      { label: "Overview", href: "/docs/api/overview" },
      { label: "gRPC Reference", href: "/docs/api/reference" },
    ],
  },
  {
    group: "Configuration",
    items: [
      { label: "Configuration", href: "/docs/configuration" },
      { label: "Security", href: "/docs/security" },
      { label: "FAQ", href: "/docs/faq" },
    ],
  },
];

function isActive(href: string) {
  if (href === "/docs")
    return currentPath === "/docs" || currentPath === "/docs/";
  return currentPath.startsWith(href);
}
---

<aside id="docs-sidebar">
  <div class="sidebar-header">
    <span class="sidebar-title">Documentation</span>
    <button class="sidebar-close" id="sidebar-close" aria-label="Close sidebar">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path
          d="M1 1l12 12M13 1L1 13"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div class="sidebar-mobile-toggle" id="sidebar-toggle">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
      <path
        d="M2 4h12M2 8h12M2 12h12"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"></path>
    </svg>
    <span>Menu</span>
  </div>

  <nav class="sidebar-nav">
    {
      nav.map((section) => (
        <div class="nav-group">
          <div class="nav-group-label">{section.group}</div>
          {section.items.map((item) => (
            <a
              href={item.href}
              class={`nav-item ${isActive(item.href) ? "nav-item-active" : ""}`}
            >
              {item.label}
            </a>
          ))}
        </div>
      ))
    }
  </nav>
</aside>

<style>
  aside {
    width: 260px;
    flex-shrink: 0;
    position: sticky;
    top: 56px;
    height: calc(100vh - 56px);
    overflow-y: auto;
    padding: 1.5rem 0;
    background: var(--bg);
  }

  .sidebar-header {
    display: none;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 0.5rem;
  }

  .sidebar-title {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .sidebar-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: none;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    border-radius: var(--radius-sm);
  }

  .sidebar-close:hover {
    background: var(--bg-elevated);
    color: var(--text-primary);
  }

  .sidebar-mobile-toggle {
    display: none;
  }

  .sidebar-nav {
    padding: 0 0.75rem;
  }

  .nav-group {
    margin-bottom: 1.75rem;
  }

  .nav-group-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding: 0 0.625rem;
    margin-bottom: 0.375rem;
  }

  .nav-item {
    display: block;
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--text-secondary);
    padding: 0.375rem 0.625rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    letter-spacing: 0.01em;
    line-height: 1.4;
  }

  .nav-item:hover {
    color: var(--text-primary);
    background: var(--bg-elevated);
  }

  .nav-item-active {
    color: var(--accent);
    background: var(--accent-dim);
    font-weight: 500;
  }

  .nav-item-active:hover {
    background: var(--accent-dim-hover);
    color: var(--accent);
  }

  aside::-webkit-scrollbar {
    width: 4px;
  }
  aside::-webkit-scrollbar-track {
    background: transparent;
  }
  aside::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 2px;
  }

  @media (max-width: 768px) {
    aside {
      position: fixed;
      top: 56px;
      left: 0;
      bottom: 0;
      z-index: 50;
      width: 280px;
      transform: translateX(-100%);
      transition: transform 200ms ease;
      border-right: 1px solid var(--border);
      height: calc(100vh - 56px);
    }

    aside.sidebar-open {
      transform: translateX(0);
    }

    .sidebar-header {
      display: flex;
    }

    .sidebar-mobile-toggle {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      position: fixed;
      bottom: 1.5rem;
      left: 1.25rem;
      z-index: 48;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 0.5rem 0.875rem;
      font-size: 0.8rem;
      font-weight: 500;
      color: var(--text-secondary);
      cursor: pointer;
      font-family: var(--font);
    }
  }
</style>

<script>
  const toggle = document.getElementById("sidebar-toggle");
  const close = document.getElementById("sidebar-close");

  toggle?.addEventListener("click", () => {
    window.dispatchEvent(new Event("open-sidebar"));
  });

  close?.addEventListener("click", () => {
    document.getElementById("docs-sidebar")?.classList.remove("sidebar-open");
    document.getElementById("sidebar-overlay")?.classList.remove("active");
  });
</script>
