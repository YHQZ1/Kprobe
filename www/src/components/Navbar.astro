---
import SearchModal from "./SearchModal";

const navLinks = [
  { label: "Docs", href: "/docs" },
  { label: "Compare", href: "/compare" },
  { label: "About", href: "/about" },
];

const currentPath = Astro.url.pathname;
---

<header id="navbar">
  <div class="navbar-inner">
    <a href="/" class="brand">
      <img
        src="/dark.png"
        width="22"
        height="22"
        alt="kprobe"
        class="icon-dark"
      />
      <img
        src="/light.png"
        width="22"
        height="22"
        alt="kprobe"
        class="icon-light"
        aria-hidden="true"
      />
      <span class="brand-name">Kprobe</span>
    </a>

    <nav class="nav-links">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class={`nav-link ${currentPath.startsWith(link.href) ? "active" : ""}`}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <button id="search-trigger" class="search-btn" aria-label="Search">
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"
          ></path>
        </svg>
        <span>Search</span>
        <kbd>
          <svg
            width="9"
            height="9"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M18 3a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3H6a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3V6a3 3 0 0 0-3-3 3 3 0 0 0-3 3 3 3 0 0 0 3 3h12a3 3 0 0 0 3-3 3 3 0 0 0-3-3z"
            ></path>
          </svg>K
        </kbd>
      </button>
      <a
        href="https://github.com/YHQZ1/kprobe"
        target="_blank"
        rel="noopener
      noreferrer"
        class="github-btn"
        aria-label="GitHub"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"
          ></path>
        </svg>
        <span>GitHub</span>
      </a>

      <button id="theme-toggle" class="icon-btn" aria-label="Toggle theme">
        <span id="icon-sun">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="4"></circle><path
              d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
            ></path>
          </svg>
        </span>
        <span id="icon-moon">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </span>
      </button>
    </div>
  </div>

  <SearchModal client:only="react" />

  <script>
    let themeTransitionTimer: number | undefined;

    function applyTheme(theme: string, animate = false) {
      if (animate) {
        window.clearTimeout(themeTransitionTimer);
        document.documentElement.classList.add("theme-transitioning");
      }

      document.documentElement.setAttribute("data-theme", theme);
      localStorage.setItem("kprobe-theme", theme);
      window.dispatchEvent(
        new CustomEvent("kprobe-theme-change", { detail: theme }),
      );

      if (animate) {
        themeTransitionTimer = window.setTimeout(() => {
          document.documentElement.classList.remove("theme-transitioning");
        }, 180);
      }
    }

    function init() {
      if (document.documentElement.dataset.navbarReady === "true") return;
      document.documentElement.dataset.navbarReady = "true";

      const html = document.documentElement;
      const toggle = document.getElementById("theme-toggle");

      applyTheme(localStorage.getItem("kprobe-theme") || "dark");

      toggle?.addEventListener("click", () => {
        applyTheme(
          html.getAttribute("data-theme") === "dark" ? "light" : "dark",
          true,
        );
      });
    }

    init();
    document.addEventListener("astro:page-load", init);
  </script>

  <style>
    #navbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      height: 56px;
      background: var(--bg);
      border-bottom: 1px solid var(--border-subtle);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    .navbar-inner {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 clamp(1rem, 4vw, 2rem);
      position: relative;
      gap: 1rem;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      flex-shrink: 0;
      text-decoration: none;
    }

    .brand-name {
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: var(--text-primary);
    }

    .nav-links {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }

    .nav-link {
      font-size: 0.875rem;
      font-weight: 500;
      letter-spacing: 0.02em;
      color: var(--text-secondary);
      padding: 0.35rem 0.75rem;
      border-radius: var(--radius-sm);
      text-decoration: none;
    }

    .nav-link:hover {
      color: var(--text-primary);
      background: var(--bg-elevated);
    }

    .nav-link.active {
      color: var(--accent);
    }

    .actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-shrink: 0;
    }

    .search-btn {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.3rem 0.75rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      background: var(--bg-subtle);
      color: var(--text-muted);
      font-size: 0.8rem;
      font-family: var(--font);
      font-weight: 400;
      cursor: pointer;
      min-width: 160px;
      max-width: 220px;
    }

    .search-btn:hover {
      border-color: var(--text-muted);
      color: var(--text-secondary);
    }

    .search-btn span {
      flex: 1;
      text-align: left;
    }

    kbd {
      display: inline-flex;
      align-items: center;
      gap: 1px;
      font-family: var(--font);
      font-size: 0.68rem;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 3px;
      padding: 0.1em 0.35em;
      color: var(--text-muted);
    }

    .github-btn {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.3rem 0.75rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border);
      background: var(--bg-subtle);
      color: var(--text-secondary);
      font-size: 0.8rem;
      font-family: var(--font);
      font-weight: 500;
      text-decoration: none;
      letter-spacing: 0.02em;
    }

    .github-btn:hover {
      color: var(--text-primary);
      border-color: var(--text-muted);
      background: var(--bg-elevated);
    }

    .icon-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      border-radius: var(--radius-sm);
      border: none;
      background: transparent;
      color: var(--text-secondary);
      cursor: pointer;
    }

    .icon-btn:hover {
      color: var(--text-primary);
      background: var(--bg-elevated);
    }

    #icon-moon {
      display: none;
    }

    [data-theme="light"] #icon-sun {
      display: none;
    }

    [data-theme="light"] #icon-moon {
      display: flex;
    }

    @media (max-width: 900px) {
      .nav-links {
        position: static;
        transform: none;
        margin-left: auto;
      }

      .search-btn {
        min-width: 38px;
        width: 38px;
        height: 34px;
        justify-content: center;
        padding: 0;
      }

      .search-btn span,
      .search-btn kbd {
        display: none;
      }
    }

    @media (max-width: 640px) {
      .brand-name {
        display: none;
      }

      .nav-links {
        gap: 0;
      }

      .nav-link {
        font-size: 0.8rem;
        padding: 0.35rem 0.45rem;
      }

      .github-btn span {
        display: none;
      }

      .github-btn {
        width: 34px;
        height: 34px;
        justify-content: center;
        padding: 0;
      }
    }

    @media (max-width: 430px) {
      .nav-link[href="/compare"] {
        display: none;
      }
    }
  </style>
</header>
